#!/usr/bin/env bash
# safe — anonymiser en fil før den sendes til Claude
#
# Bruk:    ./safe <filbane>
# Output:  anonymisert kopi skrives til ./safe-output/
#
# Originalfilen berøres aldri. All behandling skjer lokalt.
# Støttede formater: .txt  .csv  .xlsx  .docx  .pdf  .pptx

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUTPUT_DIR="$SCRIPT_DIR/safe-output"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
    echo "Bruk: ./safe <filbane>"
    echo ""
    echo "Anonymiserer PII i filen og skriver output til $OUTPUT_DIR"
    echo "Støttede formater: .txt  .csv  .xlsx  .docx  .pdf  .pptx"
    exit 0
fi

INPUT_ABS="$(realpath "${1}")"

if [[ ! -f "$INPUT_ABS" ]]; then
    echo "Feil: filen finnes ikke: $1" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR/logs"

python -m safe_cli.main "$INPUT_ABS" --output-dir "$OUTPUT_DIR"
